# Report email server (required): keep these values server-side.
RESEND_API_KEY=re_replace_me

# Resend accepts either "email@example.com" or "Name <email@example.com>".
# Replace the domain below with a domain verified in your Resend account.
# Keep the outer quotes in this file; omit them when entering the value in a hosting dashboard.
BUGRECEIPT_REPORT_FROM="BugReceipt <reports@your-verified-domain.com>"
BUGRECEIPT_REPORT_TO=you@example.com

# Report email server: use `*` for distributed unpacked builds whose Chrome IDs
# vary by install path, or an exact origin to pin a private/stable-ID build.
BUGRECEIPT_EXTENSION_ORIGIN=*

# Extension build: URL of the TanStack Start report endpoint.
# Production builds use the deployed API below. Override it with the localhost URL
# in `.env.local` only when developing the extension alongside `pnpm dev:web`.
VITE_BUGRECEIPT_REPORT_ENDPOINT=https://bugreceipt.netlify.app/api/reports
