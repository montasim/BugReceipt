# Landing-page server: keep these values server-side.
RESEND_API_KEY=re_replace_me
REPROKIT_REPORT_FROM=ReproKit <reports@example.com>
REPROKIT_REPORT_TO=maintainer@example.com

# Production should pin the installed extension origin. Leave unset only for unpacked local builds.
REPROKIT_EXTENSION_ORIGIN=chrome-extension://replace_with_extension_id

# Extension build: URL of the deployed TanStack Start report endpoint.
VITE_REPROKIT_REPORT_ENDPOINT=http://localhost:3000/api/reports
