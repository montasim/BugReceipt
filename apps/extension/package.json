{
  "name": "@bugreceipt/extension",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "description": "Capture a privacy-filtered bug reproduction bundle from the active tab.",
  "scripts": {
    "dev": "wxt",
    "prototype:ui": "vite --host 127.0.0.1 --port 4174",
    "prepare": "wxt prepare",
    "build": "wxt build",
    "zip": "pnpm check && wxt zip && pnpm validate:package",
    "validate:package": "node scripts/validate-package.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@bugreceipt/capture-model": "workspace:*",
    "@bugreceipt/issue-export": "workspace:*",
    "@bugreceipt/privacy": "workspace:*",
    "@fontsource-variable/bricolage-grotesque": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@hugeicons/core-free-icons": "^4.3.2",
    "@hugeicons/react": "^1.1.10",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "3.10.1",
    "obscenity": "0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.2.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "happy-dom": "^20.10.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "8.1.5",
    "vitest": "^4.1.10",
    "wxt": "^0.20.27"
  }
}
