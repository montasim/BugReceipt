{
  "name": "@bugreceipt/web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "BugReceipt landing page.",
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "guide:screenshots": "node scripts/capture-guide-screenshots.mjs",
    "receipt": "node scripts/render-receipt.mjs",
    "build": "pnpm receipt && tsr generate && vite build",
    "preview": "vite preview",
    "format": "prettier --write . && eslint --fix",
    "lint": "eslint",
    "test": "vitest run && node --test tests/netlify-build-filter.mjs",
    "test:deploy-filter": "node --test tests/netlify-build-filter.mjs",
    "typecheck": "tsc --noEmit",
    "check": "tsr generate && pnpm receipt && prettier --check . && eslint && tsc --noEmit && vitest run && node --test tests/netlify-build-filter.mjs && vite build"
  },
  "dependencies": {
    "@bugreceipt/capture-model": "workspace:*",
    "@bugreceipt/issue-export": "workspace:*",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@netlify/vite-plugin-tanstack-start": "^1.2.15",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "latest",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "latest",
    "eslint": "^10.7.0",
    "happy-dom": "^20.10.6",
    "typescript": "^6.0.3",
    "vite": "latest",
    "vitest": "^4.1.10"
  }
}
